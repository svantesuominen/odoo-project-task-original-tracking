<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_project_user_pivot_inherit_tracking" model="ir.ui.view">
        <field name="name">report.project.task.user.pivot.inherit.tracking</field>
        <field name="model">report.project.task.user</field>
        <field name="inherit_id" ref="project.view_task_project_user_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="deadline_diff" type="measure"/>
                <field name="allocated_hours_diff" type="measure" widget="float_time"/>
                <field name="remaining_original_hours" type="measure" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>
